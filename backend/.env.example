OPENAI_API_KEY=your_openai_api_key
INSTAGRAM_SESSIONID=
INSTAGRAM_CSRFTOKEN=
INSTAGRAM_DS_USER_ID=
# Optional TikTok cookies (analyze/download); search uses Playwright
TIKTOK_SESSIONID=
TIKTOK_MS_TOKEN=
TIKTOK_TTWID=
TIKTOK_CSRF_TOKEN=
# TikTok discover search (Playwright; prefers installed Google Chrome)
TIKTOK_SEARCH_PLAYWRIGHT=1
# 0 = headful (recommended; TikTok often blocks headless). 1 = headless
TIKTOK_PLAYWRIGHT_HEADLESS=0
# chrome | msedge | chromium
TIKTOK_PLAYWRIGHT_CHANNEL=chrome
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Hook API (app.py)
HOST=127.0.0.1
PORT=7860
DEV_UI=1
MAX_CONCURRENT_JOBS=3
MAX_QUEUE_SIZE=20
API_KEY=

# Discover
DISCOVER_TOP_N=20
DISCOVER_MAX_QUERIES=5
DISCOVER_RESULTS_PER_QUERY=24
DISCOVER_IG_MIN_DELAY_SEC=2
DISCOVER_IG_MAX_DELAY_SEC=5
DISCOVER_TT_MIN_DELAY_SEC=2
DISCOVER_TT_MAX_DELAY_SEC=5
DISCOVER_MAX_CONCURRENT_JOBS=2
DISCOVER_MAX_QUEUE_SIZE=10
TREND_VIEWS_WEIGHT=0.65
TREND_RECENCY_HALF_LIFE_DAYS=7
DISCOVER_LLM_MODEL=gpt-4o-mini
# Optional override for whoWatched / whyWatched (defaults to DISCOVER_LLM_MODEL)
AUDIENCE_LLM_MODEL=gpt-4o-mini
