OPENAI_API_KEY=your_openai_api_key
INSTAGRAM_SESSIONID=
INSTAGRAM_CSRFTOKEN=
INSTAGRAM_DS_USER_ID=

# TikTok discover search (logged-in httpx — no Playwright)
TIKTOK_SESSIONID=
TIKTOK_MS_TOKEN=
TIKTOK_TTWID=
TIKTOK_CSRF_TOKEN=
# Preferred: Netscape cookies export path (relative to backend/)
TIKTOK_COOKIES_FILE=tiktok_cookies.txt

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Hook API (app.py)
HOST=127.0.0.1
PORT=7860
DEV_UI=1
MAX_CONCURRENT_JOBS=3
MAX_QUEUE_SIZE=20
API_KEY=
# Set to 1 to let yt-dlp try Brave/Firefox/Edge cookie DBs (local only)
HOOK_BROWSER_COOKIES=0

# Discover
DISCOVER_TOP_N=20
DISCOVER_MAX_QUERIES=5
DISCOVER_RESULTS_PER_QUERY=24
DISCOVER_IG_MIN_DELAY_SEC=2
DISCOVER_IG_MAX_DELAY_SEC=5
DISCOVER_TT_MIN_DELAY_SEC=2
DISCOVER_TT_MAX_DELAY_SEC=5
DISCOVER_MAX_CONCURRENT_JOBS=2
DISCOVER_MAX_QUEUE_SIZE=10
TREND_VIEWS_WEIGHT=0.65
TREND_RECENCY_HALF_LIFE_DAYS=7
DISCOVER_LLM_MODEL=gpt-4o-mini

# Landing-page scrape (Discover). With FIRECRAWL_API_KEY set, auto uses Firecrawl (JS render + markdown).
FIRECRAWL_API_KEY=
# auto | firecrawl | httpx — auto falls back to httpx if Firecrawl fails or key missing
DISCOVER_SCRAPE_BACKEND=auto
DISCOVER_SCRAPE_TIMEOUT_SEC=45
DISCOVER_SCRAPE_MAX_CHARS=12000
