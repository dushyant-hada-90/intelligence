{
  "manifest_version": 3,
  "name": "Instagram Reel Metadata Timing Logger",
  "version": "1.2.0",
  "description": "Intercepts Instagram reel GraphQL metadata, asks a local decision server what to do, then autopilots watch/engage/scroll.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:7860/*",
    "http://localhost:7860/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
